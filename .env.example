# Copy to .env.local (git-ignored). Never commit real values.

# Postgres from Docker Compose (`pnpm db:start` or `docker compose up`). Used when you run pnpm commands
# on your machine; inside Compose the services use the `db` container automatically.
DATABASE_URL=postgres://life:life-local-dev@127.0.0.1:54329/life

# Owner identity (single owner).
LIFE_OWNER_ID=owner
LIFE_OWNER_NAME=Owner

# Studio login: scrypt hash produced by `pnpm --filter @life/studio hash-passphrase`.
STUDIO_PASSPHRASE_HASH=
# 32+ random bytes, base64, for signing the session cookie.
STUDIO_SESSION_SECRET=

# Approval signing. The private key lives ONLY with the studio process.
# Create with `pnpm --filter @life/studio approval-key`, which writes PEM files under secrets/ (git-ignored).
STUDIO_APPROVAL_KEY_ID=studio-local-1
STUDIO_APPROVAL_PRIVATE_KEY_PATH=secrets/approval-ed25519.pem
# The worker gets only the public key.
WORKER_APPROVAL_PUBLIC_KEYS_PATH=secrets/public/approval-public-keys.json

# Instagram target. `mock` until the owner authorizes live access.
INSTAGRAM_MODE=mock
INSTAGRAM_ACCOUNT_ID=mock-account

# Local object storage for media files.
LIFE_STORAGE_DIR=storage

# Voice auditions (owner's own keys; `pnpm audition` is a dry run until --confirm-spend).
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=
CARTESIA_API_KEY=

# Live Instagram (leave unset until the owner authorizes; worker refuses live mode otherwise).
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INSTAGRAM_TOKEN_KEY=
INSTAGRAM_TOKEN_KEY_ID=local-1
# Set only after the owner authorizes live publishing and the capability record is re-verified.
LIVE_PUBLISHING_AUTHORIZED=
INSTAGRAM_CAPABILITIES_VERIFIED=
# Optional OAuth path (Meta requires an https redirect); the paste-token path needs none of these.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

# Claude (drafting + independent checks). `pnpm draft` is a dry run until --confirm-spend.
ANTHROPIC_API_KEY=

# Rendering: path to a preinstalled Chrome headless shell (optional; otherwise Remotion downloads one once).
REMOTION_BROWSER_EXECUTABLE=
