{
  "name": "life-updated-studio",
  "private": true,
  "description": "Private single-owner Instagram Reels studio for LIFE: UPDATED.",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "db:start": "tsx --env-file-if-exists=.env.local packages/db/scripts/local-postgres.ts",
    "db:generate": "pnpm --filter @life/db generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local packages/db/scripts/migrate.ts",
    "slice": "tsx --env-file-if-exists=.env.local apps/worker/src/slice.ts",
    "worker": "tsx --env-file-if-exists=.env.local apps/worker/src/main.ts",
    "studio": "pnpm --filter @life/studio dev"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
